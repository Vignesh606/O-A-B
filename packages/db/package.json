{
  "name": "@oneatlas/db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply oneatlas-db --local --migrations-dir=./migrations",
    "db:push": "wrangler d1 execute oneatlas-db --local --file=./migrations/0001_initial.sql",
    "db:d1:migrate": "wrangler d1 migrations apply oneatlas-db --local --migrations-dir=./migrations",
    "db:d1:push": "wrangler d1 execute oneatlas-db --local --file=./drizzle/0000_tough_meteorite.sql",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts",
    "db:drizzle:generate": "drizzle-kit generate",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
